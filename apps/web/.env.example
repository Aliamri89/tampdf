# REQUIRED. Long random string used to sign Payload CMS auth tokens. The app
# refuses to start without it ("missing secret key" error). Generate one with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# and never reuse the same value across environments (dev/staging/prod each
# need their own).
PAYLOAD_SECRET=

# REQUIRED. Postgres connection string used by Payload CMS. Use a managed
# Postgres instance (this project uses Supabase's free tier) — if hosting
# on a shared host with IPv4-only outbound networking, use the "Session
# pooler" connection string from Supabase, not "Direct connection" (which
# is IPv6-only by default). Percent-encode special characters in the
# password (e.g. @ becomes %40).
DATABASE_URI=postgresql://user:password@host:5432/postgres

# OPTIONAL. The site's real public origin, e.g. https://tampdf.com (no
# trailing path). When set, Payload enforces a CSRF origin allowlist for
# authenticated admin/API requests. Safe to leave unset — origin-checking
# is simply skipped, which is fine for this single-admin app — but
# recommended once the production domain is live.
SERVER_URL=

# REQUIRED IN PRODUCTION. Absolute path where Payload writes uploaded media,
# e.g. /home/<user>/media-uploads. It must point OUTSIDE the deployed app
# directory: hosts like Hostinger replace that directory on every deploy,
# which deletes every uploaded file while the database rows referencing them
# survive — leaving every image URL broken. Leave unset locally; it then
# falls back to apps/web/media-uploads/ (gitignored). See DEPLOYMENT.md § 5.
MEDIA_UPLOAD_DIR=

# OPTIONAL. "Save to Google Drive" / "Save to Dropbox" buttons on the result
# screen. Each button only appears when its id is set; both are public
# identifiers (not secrets) and are baked in at BUILD time, so set them in
# the host's environment before building. See DEPLOYMENT.md.
#   Google: Google Cloud Console -> APIs & Services -> Credentials -> OAuth
#   client ID (Web application). Enable the Google Drive API, add the site
#   origin (https://tampdf.com) under "Authorized JavaScript origins".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
#   Dropbox: dropbox.com/developers/apps -> Create app (Scoped access, App
#   folder). Enable the files.content.write permission and add the redirect
#   URI https://tampdf.com/oauth/dropbox (plus http://localhost:3000/oauth/dropbox for testing).
NEXT_PUBLIC_DROPBOX_APP_KEY=

# OPTIONAL. Google AdSense. With none of these set, the site renders no ad
# code, no ad space and no ads.txt. Public identifiers, baked in at BUILD time.
#   NEXT_PUBLIC_ADSENSE_CLIENT: publisher id, e.g. ca-pub-1234567890123456
#   NEXT_PUBLIC_ADSENSE_SLOT_TOOL / _BLOG: ad unit ids (digits) from
#   AdSense -> Ads -> By ad unit. /ads.txt is served automatically.
#   For visitors in the EEA/UK/Switzerland also turn on Google's consent
#   message: AdSense -> Privacy & messaging.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL=
NEXT_PUBLIC_ADSENSE_SLOT_BLOG=
